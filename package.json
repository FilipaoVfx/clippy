{
  "name": "clippy",
  "version": "1.0.0",
  "description": "Real-time clipboard sync between devices via pairing codes",
  "main": "server/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.cjs",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "cf:deploy": "npm run deploy",
    "vendor:three": "node scripts/vendor-three.mjs",
    "e2e:visual": "node scripts/e2e-visual.mjs",
    "site:build": "node scripts/build-site.mjs",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "keywords": [
    "clipboard",
    "sync",
    "realtime",
    "websocket"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright-core": "1.61.1",
    "three": "0.186.1",
    "vitest": "^4.1.9",
    "wrangler": "4.158.0"
  }
}
