  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Create or send content. Light-theme dark fill; yellow in dark theme.",
      "html": "<button class=\"ds-primary\">Create room <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font:700 14px/1.6 Manrope,Arial,sans-serif;transition:background .18s,transform .18s;background:#242223;color:#fffaf4;border:1px solid #242223;border-radius:32px;padding:12px 22px;min-height:48px;cursor:pointer}.ds-primary:hover{background:#45403b;transform:translateY(-2px)}.ds-primary:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}.ds-primary{display:inline-flex;align-items:center;gap:12px}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Cancel or leave a secondary task.",
      "html": "<button class=\"ds-ghost\">Cancel</button>",
      "css": ".ds-ghost{font:400 13px/1.6 Manrope,Arial,sans-serif;border:1px solid var(--line);border-radius:30px;padding:10px 26px;min-height:44px;color:var(--ink);background:transparent;cursor:pointer}.ds-ghost:hover{border-color:var(--error);color:var(--error)}.ds-ghost:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}"
    },
    {
      "name": "Session code field",
      "kind": "input",
      "refersTo": "input-code",
      "description": "A recessed code input with a compact arrow action.",
      "html": "<div class=\"ds-code\"><input aria-label=\"Session code\" placeholder=\"ABC-12K\"><button aria-label=\"Join session\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button></div>",
      "css": ".ds-code{display:flex;align-items:center;min-height:48px;padding:4px;border:1px solid #bfb0a4;border-radius:32px;background:var(--input);max-width:300px}.ds-code input{font:400 16px/1.6 ui-monospace,monospace;text-align:center;letter-spacing:.045em;text-transform:uppercase;color:var(--ink);background:transparent;border:0;border-radius:24px;padding:7px 8px;min-width:0;width:100%}.ds-code button{border:0;width:38px;height:38px;flex-shrink:0;border-radius:50%;background:#242223;color:#fffaf4;cursor:pointer}.ds-code button:hover{background:var(--yellow);color:#222122}.ds-code input:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}.ds-code button:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}"
    },
    {
      "name": "Sharing textarea",
      "kind": "input",
      "refersTo": "textarea",
      "description": "Readable text entry in a recessed surface.",
      "html": "<textarea class=\"ds-textarea\" aria-label=\"Text to share\" placeholder=\"Paste or type text here...\"></textarea>",
      "css": ".ds-textarea{width:100%;min-height:105px;padding:14px;border:1px solid var(--line);border-radius:14px;background:var(--input);color:var(--ink);font:400 16px/1.6 Manrope,Arial,sans-serif;resize:vertical;caret-color:var(--yellow-ink)}.ds-textarea::placeholder{color:var(--muted);font-size:14px}.ds-textarea:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}"
    },
    {
      "name": "Connection status",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Runtime text and semantic dot in a quiet pill.",
      "html": "<div class=\"ds-status\"><span></span>Ready to pair</div>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:9px;font:400 13px/1.6 Manrope,Arial,sans-serif;min-height:46px;padding:10px 16px;border:1px solid var(--line);border-radius:32px;background:var(--paper);color:var(--ink)}.ds-status span{width:9px;height:9px;border-radius:50%;background:var(--success)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "A selected Connect action beside inline help.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#\" aria-current=\"page\">Connect</a><button>How it works</button></nav>",
      "css": ".ds-nav{display:inline-flex;gap:4px;padding:4px;border:1px solid var(--line);border-radius:40px;background:var(--paper)}.ds-nav a,.ds-nav button{font:400 14px/1.6 Manrope,Arial,sans-serif;border:0;border-radius:32px;padding:10px 20px;background:transparent;color:var(--ink);text-decoration:none;cursor:pointer}.ds-nav a[aria-current]{background:#222122;color:#fff9f1}.ds-nav button:hover{background:var(--input)}.ds-nav a:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}.ds-nav button:focus-visible{outline:3px solid var(--yellow-ink);outline-offset:4px}"
    },
    {
      "name": "Task container",
      "kind": "card",
      "refersTo": "pairing-panel",
      "description": "A shared warm surface for related pairing actions.",
      "html": "<section class=\"ds-panel\"><strong>Start a session</strong><p>Create a room and get your unique code.</p></section>",
      "css": ".ds-panel{max-width:640px;padding:30px 34px 28px;border:1px solid var(--line);border-radius:32px;background:color-mix(in srgb,var(--surface) 93%,transparent);box-shadow:0 24px 45px #60442114;color:var(--ink);font:400 14px/1.6 Manrope,Arial,sans-serif}.ds-panel strong{font-size:18px;font-weight:800}.ds-panel p{color:var(--muted);margin:7px 0 0}"
    },
    {
      "name": "Success toast",
      "kind": "custom",
      "description": "Temporary feedback; duplicates replace, stack limited to one mobile/two desktop.",
      "html": "<div class=\"ds-toast\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"m5 12 4 4L19 6\"/></svg>Copied!</div>",
      "css": ".ds-toast{display:flex;align-items:center;gap:9px;padding:13px 18px;border:1px solid var(--success);border-radius:14px;background:var(--surface-solid);color:var(--ink);box-shadow:0 8px 24px #3a291c24;font:400 13px/1.6 Manrope,Arial,sans-serif}.ds-toast svg{width:16px;height:16px;flex-shrink:0;color:var(--success)}"
    }
  ],
  "narrative": {
    "northStar": "A little connection",
    "overview": "Pastty uses the user's supplied concept as its visual authority: a warm ivory field, yellow pasta connections, dimensional device tiles and bold black lettering. The physical artwork frames a real, compact application; headings and controls remain live HTML. The same vocabulary continues through pairing, waiting and sharing.",
    "keyCharacteristics": [
      "Warm ivory surfaces with black type and golden accents.",
      "Real 3D device artwork around a quiet central task.",
      "Chunky Russo One display lettering paired with Manrope interface text.",
      "Rounded controls, fine warm borders and restrained ambient depth.",
      "A dark theme that keeps the same material family and yellow accent."
    ],
    "rules": [
      {
        "name": "The Readable Gold Rule",
        "body": "Use Golden Ink for small accent text; Pasta Yellow is reserved for material, fills and surfaces that retain dark foreground text.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Russo One names the brand and important states; Manrope carries instructions and actions. Keep long text and field content out of display type.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the supplied ivory, black, yellow and 3D device identity.",
      "Do keep the central task legible while artwork frames the outer space.",
      "Do use real controls, keyboard focus, labels and runtime feedback.",
      "Do apply both theme palettes and reduced-motion behavior to new components.",
      "Do retain a white QR quiet zone and readable contrast in both themes."
    ],
    "donts": [
      "Don't bake headings, navigation or interactive controls into the artwork.",
      "Don't replace the supplied physical 3D material with flat CSS approximations.",
      "Don't use the display face for instructions or long shared content.",
      "Don't treat small status captions as the default size for new body copy."
    ]
  }
}
